[Unit]
Description=Ghosted Discord Worker
After=network.target

[Service]
Type=simple
User=ghosted
Group=ghosted
WorkingDirectory=/opt/ghosted
EnvironmentFile=/etc/ghosted/ghosted.env
ExecStart=/usr/bin/node /opt/ghosted/scripts/discord-worker.mjs
Restart=always
RestartSec=5

# Keep runtime state outside the repo checkout.
ReadWritePaths=/var/lib/ghosted

[Install]
WantedBy=multi-user.target
