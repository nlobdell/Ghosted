# Register https://ghosted.example.com/api/auth/callback/discord in the Discord app settings.

DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
DISCORD_MEMBER_ROLE_ID=
DISCORD_VIP_ROLE_ID=
DISCORD_GIVEAWAY_ROLE_ID=
DISCORD_ROLE_LABELS_JSON={}
DISCORD_WEBHOOK_URL=

ADMIN_DISCORD_IDS=
ENABLE_DEV_AUTH=false
DEV_AUTH_ADMIN=false

WOM_GROUP_ID=
WOM_API_BASE=https://api.wiseoldman.net/v2
