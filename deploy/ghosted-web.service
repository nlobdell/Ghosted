[Unit]
Description=Ghosted Next.js Web App
After=network.target

[Service]
Type=simple
User=ghosted
Group=ghosted
WorkingDirectory=/opt/ghosted
EnvironmentFile=/etc/ghosted/ghosted.env
ExecStart=/usr/bin/node /opt/ghosted/.next/standalone/server.js
Restart=always
RestartSec=5

# Keep runtime state outside the repo checkout.
ReadWritePaths=/var/lib/ghosted

[Install]
WantedBy=multi-user.target
