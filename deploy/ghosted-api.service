[Unit]
Description=Ghosted Python API
After=network.target

[Service]
Type=simple
User=ghosted
Group=ghosted
WorkingDirectory=/opt/ghosted/current-api
EnvironmentFile=/etc/ghosted/ghosted.env
ExecStart=/usr/bin/python3 /opt/ghosted/current-api/server.py
Restart=always
RestartSec=5

# Keep runtime state outside the release bundle.
ReadWritePaths=/var/lib/ghosted

[Install]
WantedBy=multi-user.target
